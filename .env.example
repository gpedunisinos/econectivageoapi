APP_NAME="Unisinos USP Geo API"
APP_VERSION=0.1.0
ENVIRONMENT=development
API_TOKEN=change-this-token
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

DATABASE_URL=postgresql://geo:geo@postgis:5432/geo
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5

MAPBIOMAS_COG_URL=
ELEVATION_COG_URL=
SLOPE_COG_URL=
# COGs reduzidos e com overviews destinados somente aos tiles do mapa.
# Quando vazios, as fontes analíticas acima são utilizadas como fallback.
ELEVATION_TILE_COG_URL=
SLOPE_TILE_COG_URL=
RASTER_CACHE_MAX_AGE=86400
RASTER_TILE_CACHE_DIR=/data/tile-cache
# Altere a versão para invalidar o cache após atualizar as fontes ou os estilos.
RASTER_TILE_CACHE_VERSION=v1

# Crie uma chave gratuita no ArcGIS Location Platform com acesso a mapas-base.
# Sem token a camada aparece no catálogo como indisponível e não gera cobrança.
ESRI_BASEMAP_ENABLED=false
ESRI_BASEMAP_TOKEN=
ESRI_BASEMAP_URL=https://ibasemaps-api.arcgis.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
ESRI_TIMEOUT_SECONDS=15

LAND_COVER_RADIUS_M=250
SLOPE_RADIUS_M=100

# Ative somente depois de importar e normalizar as respectivas tabelas.
BIOMES_ENABLED=false
HYDROGRAPHY_ENABLED=false
POPULATION_ENABLED=false
